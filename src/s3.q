// S3-Compatible Object Storage Client (Presigned URLs)
// Copyright (c) 2026 Evgen Bielozorov
// Licensed under the Apache License, Version 2.0

// Documentation: https://github.com/BuaBook/kdb-common/wiki/s3.q

// NOTE: This library does NOT implement AWS SigV4 request signing (qbase has no SHA-256 / HMAC
//       primitive available). It is a thin client for S3-style *presigned URLs* - URLs that
//       already embed all authentication/authorization in their query string (as generated by
//       'aws s3 presign', boto3's 'generate_presigned_url', or any S3-compatible service, e.g.
//       MinIO). Given such a URL, only the correct HTTP method, matching headers (e.g.
//       'Content-Type' for a PUT) and body are required - all of which '.http.get' / '.http.put' /
//       '.http.delete' already handle. This module adds a clean, S3-shaped API on top of those
//       calls and turns the XML error body S3 returns on failure into a useful error.

.require.lib each `http`type;


/ The 'Content-Type' used for '.s3.putObject' if none is specified. This is S3's own default and
/ is deliberately NOT left to '.http.put' / '.http.send', which default to 'text/plain' instead
.s3.cfg.defaultContentType:"application/octet-stream";


.s3.init:{};


/ Downloads an object from S3 (or an S3-compatible service) via a presigned GET URL
/  @param presignedUrl (String) The presigned URL to GET, as generated by 'aws s3 presign' or equivalent
/  @returns (String) The object content, as returned in the HTTP response body
/  @throws IllegalArgumentException If 'presignedUrl' is not a string
/  @throws S3RequestFailedException If the request does not return a successful (2xx) status
/  @see .http.get
/  @see .s3.i.raiseIfError
.s3.getObject:{[presignedUrl]
    if[not .type.isString presignedUrl;
        '"IllegalArgumentException";
    ];

    response:.http.get[presignedUrl; ()!()];
    .s3.i.raiseIfError response;

    :response`body;
 };

/ Uploads an object to S3 (or an S3-compatible service) via a presigned PUT URL
/  @param presignedUrl (String) The presigned URL to PUT to, as generated by 'aws s3 presign' or equivalent
/  @param body (String) The object content to upload
/  @param contentType (String) The 'Content-Type' to send. Must match the content type used when the URL was
/   presigned if one was specified there. If empty, defaults to '.s3.cfg.defaultContentType'
/  @returns (Boolean) True if the upload succeeded. S3 PUT responses have no useful body on success
/  @throws IllegalArgumentException If 'presignedUrl' or 'body' is not a string
/  @throws S3RequestFailedException If the request does not return a successful (2xx) status
/  @see .http.put
/  @see .s3.cfg.defaultContentType
/  @see .s3.i.raiseIfError
.s3.putObject:{[presignedUrl; body; contentType]
    if[not all .type.isString each (presignedUrl; body);
        '"IllegalArgumentException";
    ];

    if[0 = count contentType;
        contentType:.s3.cfg.defaultContentType;
    ];

    response:.http.put[presignedUrl; body; contentType; ()!()];
    .s3.i.raiseIfError response;

    :1b;
 };

/ Deletes an object from S3 (or an S3-compatible service) via a presigned DELETE URL
/  @param presignedUrl (String) The presigned URL to DELETE, as generated by 'aws s3 presign' or equivalent
/  @returns (Boolean) True if the delete succeeded. S3 commonly returns '204 No Content' on success, which is
/   still covered by the 'success' status type
/  @throws IllegalArgumentException If 'presignedUrl' is not a string
/  @throws S3RequestFailedException If the request does not return a successful (2xx) status
/  @see .http.delete
/  @see .s3.i.raiseIfError
.s3.deleteObject:{[presignedUrl]
    if[not .type.isString presignedUrl;
        '"IllegalArgumentException";
    ];

    response:.http.delete[presignedUrl; ""; ""; ()!()];
    .s3.i.raiseIfError response;

    :1b;
 };


/ Raises an exception if the specified '.http.*' response indicates a failure, logging the parsed S3 error first.
/ Does nothing if the response status type is 'success'
/  @param response (Dict) A parsed HTTP response, as returned by '.http.get' / '.http.put' / '.http.delete'
/  @throws S3RequestFailedException If 'response`statusType' is not `success
/  @see .http.i.parseResponse
/  @see .s3.i.parseErrorXml
.s3.i.raiseIfError:{[response]
    if[`success = response`statusType;
        :(::);
    ];

    parsedError:.s3.i.parseErrorXml response`body;

    .log.if.error "S3 request failed [ Status Code: ",string[response`statusCode]," ] [ Error Code: ",.type.ensureString[parsedError`code]," ]. Error - ",parsedError`message;

    '"S3RequestFailedException (",string[response`statusCode],": ",.type.ensureString[parsedError`code],")";
 };

/ Parses an S3-style error XML body (e.g. '<Error><Code>AccessDenied</Code><Message>...</Message></Error>') into
/ a dictionary. No XML parsing library is used - just the content between the known '<Code>' / '<Message>' tags,
/ matching the lightweight string handling used elsewhere in this codebase (e.g. 'jschema.q', 'csv.q')
/  @param xmlBody (String) The HTTP response body to parse
/  @returns (Dict) `code (Symbol) and `message (String). If 'xmlBody' does not look like S3 error XML (the
/   '<Code>' / '<Message>' tags cannot both be found), `code is set to `UnknownError and `message is set to
/   the raw, unparsed 'xmlBody' so callers still get something useful
.s3.i.parseErrorXml:{[xmlBody]
    code:.s3.i.extractTag[xmlBody; "Code"];
    message:.s3.i.extractTag[xmlBody; "Message"];

    if[(0 = count code) | (0 = count message);
        :`code`message!(`UnknownError; xmlBody);
    ];

    :`code`message!(`$code; message);
 };

/ Extracts the text content between the first occurrence of '<tagName>' and '</tagName>' in 'xmlBody'
/  @param xmlBody (String) The XML (or XML-like) string to search
/  @param tagName (String) The tag name to extract the content of, without angle brackets
/  @returns (String) The content between the open and close tags, or an empty string if the tag pair cannot
/   be found (missing, unmatched or empty)
.s3.i.extractTag:{[xmlBody; tagName]
    openTag:"<",tagName,">";
    closeTag:"</",tagName,">";

    openIdx:xmlBody ss openTag;
    closeIdx:xmlBody ss closeTag;

    if[(0 = count openIdx) | (0 = count closeIdx);
        :"";
    ];

    start:(first openIdx) + count openTag;
    end:first closeIdx;

    if[end <= start;
        :"";
    ];

    :(end - start)#start _ xmlBody;
 };
