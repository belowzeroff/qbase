.require.lib`type;


// -- .type.isDict --------------------------------------------------------------

.t.type_isDict_trueForDict:{[]
    .test.assert.true[.type.isDict `a`b!1 2];
 };

.t.type_isDict_falseForList:{[]
    .test.assert.false[.type.isDict (1 2 3)];
 };

.t.type_isDict_trueForEmptyDict:{[]
    .test.assert.true[.type.isDict ()!()];
 };


// -- .type.isSymbol -------------------------------------------------------------

.t.type_isSymbol_trueForSymbol:{[]
    .test.assert.true[.type.isSymbol `abc];
 };

.t.type_isSymbol_falseForString:{[]
    .test.assert.false[.type.isSymbol "abc"];
 };

.t.type_isSymbol_trueForEmptySymbol:{[]
    .test.assert.true[.type.isSymbol `];
 };


// -- .type.isFunction -----------------------------------------------------------

.t.type_isFunction_trueForLambda:{[]
    .test.assert.true[.type.isFunction {x+1}];
 };

.t.type_isFunction_falseForAtom:{[]
    .test.assert.false[.type.isFunction 5];
 };

.t.type_isFunction_trueForProjection:{[]
    .test.assert.true[.type.isFunction {x+y}[1;]];
 };


// -- .type.isString -------------------------------------------------------------

.t.type_isString_trueForString:{[]
    .test.assert.true[.type.isString "hello"];
 };

.t.type_isString_falseForSymbol:{[]
    .test.assert.false[.type.isString `hello];
 };

.t.type_isString_trueForEmptyString:{[]
    .test.assert.true[.type.isString ""];
 };


// -- .type.isLong -----------------------------------------------------------------
// (auto-generated by '.type.i.setCheckFuncs' from '.type.const.types' during '.type.init')

.t.type_isLong_trueForLongAtom:{[]
    .test.assert.true[.type.isLong 5];
 };

.t.type_isLong_falseForIntAtom:{[]
    .test.assert.false[.type.isLong 5i];
 };

.t.type_isLong_trueForNullLong:{[]
    .test.assert.true[.type.isLong 0N];
 };


// -- .type.isFilePath / .type.isFile / .type.isFolder ----------------------------

.t.type_isFilePath_trueForPath:{[]
    .test.assert.true[.type.isFilePath `:/tmp];
 };

.t.type_isFilePath_falseForPlainSymbol:{[]
    .test.assert.false[.type.isFilePath `abc];
 };

.t.type_isFilePath_trueForRootPath:{[]
    .test.assert.true[.type.isFilePath `:];
 };

.t.type_isFile_isFolder_trueFalseForRealFileAndFolder:{[]
    dir:`:/tmp/qbase_test_type_dir;
    file:`:/tmp/qbase_test_type_dir/file.txt;

    system "mkdir -p /tmp/qbase_test_type_dir";
    file 0: enlist "hello";

    .test.assert.true[.type.isFile file];
    .test.assert.false[.type.isFolder file];
    .test.assert.true[.type.isFolder dir];
    .test.assert.false[.type.isFile dir];

    hdel file;
    system "rmdir /tmp/qbase_test_type_dir";
 };

.t.type_isFile_nonPathRaises:{[]
    .test.assert.raisesLike[.type.isFile; enlist `notAPath; "*IllegalArgumentException*"];
 };

.t.type_isFolder_nonPathRaises:{[]
    .test.assert.raisesLike[.type.isFolder; enlist `notAPath; "*IllegalArgumentException*"];
 };


// -- .type.ensureString -----------------------------------------------------------

.t.type_ensureString_stringPassesThrough:{[]
    .test.assert.equals["hello"; .type.ensureString "hello"];
 };

.t.type_ensureString_symbolToString:{[]
    .test.assert.equals["hello"; .type.ensureString `hello];
 };

.t.type_ensureString_emptyTypedListReturnsEmptyString:{[]
    .test.assert.equals[""; .type.ensureString `symbol$()];
 };


// -- .type.ensureSymbol -----------------------------------------------------------

.t.type_ensureSymbol_symbolPassesThrough:{[]
    .test.assert.equals[`abc; .type.ensureSymbol `abc];
 };

.t.type_ensureSymbol_numberToSymbol:{[]
    .test.assert.equals[`123; .type.ensureSymbol 123];
 };

.t.type_ensureSymbol_emptyStringToEmptySymbol:{[]
    .test.assert.equals[`; .type.ensureSymbol ""];
 };
